<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:layoutDirection="locale"
    android:fitsSystemWindows="true">

    <!-- ================= المحتوى الرئيسي ================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/royal26" />
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#66000000" />
        </FrameLayout>

        <!-- الشريط العلوي الزجاجي -->
        <LinearLayout
            android:id="@+id/topBarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:weightSum="3"
            android:paddingHorizontal="4dp"
            android:paddingVertical="5dp"
            android:gravity="top"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/btn_menu_click"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/blurMenuBtn"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_glass_circle_border"
                    android:clipToOutline="true"
                    app:blurOverlayColor="#0DFFFFFF">
                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_menu_royal"
                        app:tint="#FFD700" />
                </eightbitlab.com.blurview.BlurView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_gravity="center_vertical">
                <TextView
                    android:id="@+id/tv_header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:shadowColor="#FF000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="2" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_language_click"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/blurLangBtn"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_glass_circle_border"
                    android:clipToOutline="true"
                    app:blurOverlayColor="#0DFFFFFF">
                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_language_royal"
                        app:tint="#FFD700" />
                </eightbitlab.com.blurview.BlurView>
            </LinearLayout>
        </LinearLayout>

        <!-- أزرار الشاشة المركزية -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingBottom="20dp"
            android:fillViewport="false"
            app:layout_constraintTop_toBottomOf="@id/topBarContainer"
            app:layout_constraintBottom_toTopOf="@+id/banner_container">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="30dp"
                android:gravity="center_horizontal">

                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/blurBtnDownload2027"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_glass_border"
                    android:clipToOutline="true"
                    app:blurOverlayColor="#1AFFFFFF">

                    <LinearLayout
                        android:id="@+id/btn_download_2027_click"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">
                        <TextView
                            android:id="@+id/tv_btn_download_2027"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/download_2027"
                            android:textColor="#FFD700"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:shadowColor="#FF000000"
                            android:shadowDx="1"
                            android:shadowDy="1"
                            android:shadowRadius="4" />
                    </LinearLayout>
                </eightbitlab.com.blurview.BlurView>

                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/blurBtnDownloadVip"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_glass_border"
                    android:clipToOutline="true"
                    app:blurOverlayColor="#1A00FFFF"> 

                    <LinearLayout
                        android:id="@+id/btn_download_vip_click"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">
                        <TextView
                            android:id="@+id/tv_btn_download_vip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/download_vip"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:shadowColor="#FF000000"
                            android:shadowDx="1"
                            android:shadowDy="1"
                            android:shadowRadius="4" />
                    </LinearLayout>
                </eightbitlab.com.blurview.BlurView>

                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/blurBtnPreview"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:layout_marginHorizontal="20dp"
                    android:background="@drawable/bg_glass_border"
                    android:clipToOutline="true"
                    app:blurOverlayColor="#1AFFD700"> 

                    <LinearLayout
                        android:id="@+id/btn_preview_click"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">
                        <TextView
                            android:id="@+id/tv_btn_preview"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/preview_org"
                            android:textColor="#000000"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </eightbitlab.com.blurview.BlurView>

            </LinearLayout>
        </ScrollView>

        <FrameLayout
            android:id="@+id/banner_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:background="#1A000000"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ================= القائمة الجانبية الزجاجية العائمة ================= -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurDrawerContainer"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_glass_border"
        android:clipToOutline="true"
        app:blurOverlayColor="#E60A0A0A">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="30dp"
            android:paddingHorizontal="16dp">

            <!-- عنوان القائمة -->
            <TextView
                android:id="@+id/tv_menu_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/more_menu"
                android:textColor="#FFD700"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="30dp"
                android:shadowColor="#000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="3"/>

            <!-- زر سياسة الخصوصية -->
            <LinearLayout
                android:id="@+id/nav_privacy_click"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingStart="16dp"
                android:layout_marginBottom="8dp">
                
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_privacy_royal"
                    app:tint="#FFFFFF"
                    android:layout_marginEnd="16dp" />
                    
                <TextView
                    android:id="@+id/tv_nav_privacy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/privacy_policy"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- زر التواصل تيليجرام -->
            <LinearLayout
                android:id="@+id/nav_telegram_click"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingStart="16dp"
                android:layout_marginBottom="24dp">
                
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_telegram_royal"
                    app:tint="#00E5FF"
                    android:layout_marginEnd="16dp" />
                    
                <TextView
                    android:id="@+id/tv_nav_telegram"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/contact_telegram"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- الحقوق -->
            <TextView
                android:id="@+id/tv_copyright"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/copyright"
                android:textColor="#FFD700"
                android:textAlignment="center"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>

</androidx.drawerlayout.widget.DrawerLayout>
