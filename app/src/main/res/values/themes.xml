<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    
    <!-- الثيم الأساسي للتطبيق -->
    <style name="Base.Theme.RoyalOrg2026" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- الألوان الرئيسية -->
        <item name="colorPrimary">@color/royal_primary</item>
        <item name="colorPrimaryVariant">@color/royal_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- لون التحديد والأزرار -->
        <item name="colorSecondary">@color/royal_accent</item>
        <item name="colorSecondaryVariant">@color/royal_accent</item>
        <item name="colorOnSecondary">@color/black</item>
        
        <!-- لون شريط الإشعارات (Status Bar) -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
    </style>

    <style name="Theme.RoyalOrg2026" parent="Base.Theme.RoyalOrg2026" />

    <!-- ثيم مخصص للشاشات التي لا تحتاج شريط علوي -->
    <style name="Theme.RoyalOrg2026.NoActionBar" parent="Theme.RoyalOrg2026">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
