<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/royal26">

    <!-- طبقة شفافة داكنة فوق الخلفية لتوضيح النصوص -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Language\nاختر اللغة"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/btn_arabic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        android:layout_marginBottom="40dp"/>

    <!-- زر اللغة العربية -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_arabic"
        android:layout_width="250dp"
        android:layout_height="60dp"
        android:text="العربية"
        android:textSize="20sp"
        android:textColor="@color/royal_accent"
        app:backgroundTint="#33000000"
        app:strokeColor="@color/royal_accent"
        app:strokeWidth="2dp"
        app:cornerRadius="15dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_english"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        android:layout_marginBottom="20dp"/>

    <!-- زر اللغة الإنجليزية -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_english"
        android:layout_width="250dp"
        android:layout_height="60dp"
        android:text="English"
        android:textSize="20sp"
        android:textColor="@color/white"
        app:backgroundTint="#33000000"
        app:strokeColor="@color/white"
        app:strokeWidth="2dp"
        app:cornerRadius="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_arabic" />

</androidx.constraintlayout.widget.ConstraintLayout>

