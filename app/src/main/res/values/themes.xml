<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    
    <!-- الثيم الرئيسي (متوافق مع تصميم الزجاج والإضاءة) -->
    <style name="Theme.RoyalOrg2026" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/neon_gold</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/neon_blue</item>
        
        <!-- جعل أشرطة النظام شفافة ليمتد التصميم تحتها -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.RoyalOrg2026.NoActionBar" parent="Theme.RoyalOrg2026">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
